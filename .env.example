# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Required for internet search; if omitted, regular Gemini answers still work
SERPER_API_KEY=

# Optional; default is a fast and cost-efficient Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Upstash Redis (Vercel → Storage). Lets slow answers finish in the background;
# the user then says «дальше». Vercel sets KV_REST_API_URL and KV_REST_API_TOKEN automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
